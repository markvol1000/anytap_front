# API mode: mock (local UI only) | http (Spring Boot ALB — recommended)
VITE_API_MODE=http

# ─── Spring Boot / AnyTap ALB backend ───
# Local dev: /api/v1 is proxied to ALB (see vite.config.js)
# Vercel: use /api/v1 (vercel.json proxies to ALB — no CORS needed)
# Local dev: same — vite.config.js proxies to ALB
VITE_API_BASE_URL=/api/v1
# Direct ALB URL only if backend CORS allows your domain:
# VITE_API_BASE_URL=http://anytap-alb-1199820250.ap-northeast-2.elb.amazonaws.com/api/v1
#
# Backend E2E dashboard (IP whitelist may be required):
# http://anytap-alb-1199820250.ap-northeast-2.elb.amazonaws.com/views/test-dashboard.html
# OpenAPI: /api-docs  |  Swagger UI: /swagger-ui/index.html
VITE_MERCHANT_ID=test-merchant
# Deprecated — SignUpRequest no longer accepts kycKey
# VITE_BACKEND_KYC_KEY=
